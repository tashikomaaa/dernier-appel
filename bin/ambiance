#!/usr/bin/env python3
"""ambiance — fabrique un fond de bar en boucle, libre de droits par construction.

Le fond n'est pas un enregistrement : il est synthétisé couche par couche —
l'air de la salle, la rumeur des conversations, les verres, les chaises. Rien à
licencier, et la même graine redonne exactement le même fond, donc l'identité
sonore de l'émission reste stable d'un épisode à l'autre.

La boucle est raccordée sur elle-même : son dernier instant enchaîne sur son
premier sans accroc, donc « master » peut la répéter indéfiniment.

    bin/ambiance                             60 s, stéréo, dans assets/
    bin/ambiance -d 2:00 --densite 20        plus longue, plus animée
    bin/ambiance --graine 7 --rumeur 40      autre salle, plus calme
"""
import argparse
import os
import random
import subprocess
import sys
import tempfile
from pathlib import Path

RACINE = Path(__file__).resolve().parent.parent


def ff(*args, entree=None):
    r = subprocess.run(["ffmpeg", "-y", "-hide_banner", "-v", "error", *args],
                       capture_output=True, text=True, input=entree)
    if r.returncode != 0:
        sys.exit(f"ffmpeg a échoué :\n{r.stderr.strip()}")


def duree_de(f):
    r = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration",
                        "-of", "csv=p=0", str(f)], capture_output=True, text=True)
    return float(r.stdout.strip())


def secondes(texte):
    """Accepte « 90 » ou « 1:30 »."""
    if ":" in texte:
        m, s = texte.split(":")
        return int(m) * 60 + float(s)
    return float(texte)


# Les événements du bar. Un tintement de verre est un petit accord de partiels
# hautes fréquences qui s'éteint vite ; une chaise ou un pas est une bouffée de
# bruit grave. C'est tout ce qu'il faut pour que l'oreille situe la pièce.
EVENEMENTS = [
    ("verre_fin",   [2600, 3900, 5600], 0.38, 0.55),
    ("verre_epais", [3100, 4700, 6200], 0.22, 0.45),
    ("bouteille",   [1750, 2680, 3520], 0.55, 0.40),
    ("cuillere",    [4200, 6100, 7800], 0.16, 0.30),
]


def rendre_evenements(tmp: Path, rng: random.Random) -> list[Path]:
    fichiers = []
    for nom, partiels, decroissance, niveau in EVENEMENTS:
        cible = tmp / f"{nom}.wav"
        entrees, graphe, etiquettes = [], [], []
        for i, f in enumerate(partiels):
            entrees += ["-f", "lavfi", "-i", f"sine=f={f}:d={decroissance}:r=48000"]
            gain = niveau / (i + 1.6) ** 1.3
            graphe.append(f"[{i}:a]volume={gain:.4f}[p{i}]")
            etiquettes.append(f"[p{i}]")
        graphe.append(
            "".join(etiquettes) + f"amix=inputs={len(partiels)}:normalize=0,"
            f"afade=t=in:st=0:d=0.004:curve=qsin,"
            f"afade=t=out:st=0:d={decroissance}:curve=exp[o]")
        ff(*entrees, "-filter_complex", ";".join(graphe), "-map", "[o]",
           "-ar", "48000", "-ac", "1", "-c:a", "pcm_f32le", str(cible))
        fichiers.append(cible)

    # Chaise, pas, porte lointaine : du bruit grave très court.
    for nom, coupe, duree, niveau in [("chaise", 240, 0.20, 0.30), ("sourd", 150, 0.35, 0.22)]:
        cible = tmp / f"{nom}.wav"
        # La graine est indispensable : sans elle ffmpeg part de l'horloge et
        # l'événement change à chaque exécution, ce qui casse la reproductibilité.
        ff("-f", "lavfi", "-i",
           f"anoisesrc=c=brown:a=0.9:d={duree}:r=48000:seed={rng.randrange(10**6)}",
           "-af", f"lowpass=f={coupe},afade=t=out:st=0:d={duree}:curve=exp,volume={niveau}",
           "-ar", "48000", "-ac", "1", "-c:a", "pcm_f32le", str(cible))
        fichiers.append(cible)
    return fichiers


def construire(a, tmp: Path) -> Path:
    rng = random.Random(a.graine)
    total = a.duree + a.fondu
    canaux = 1 if a.mono else 2
    evenements = rendre_evenements(tmp, rng)

    entrees, graphe, couches = [], [], []
    n = 0

    def ajouter_bruit(couleur, graine):
        nonlocal n
        entrees.extend(["-f", "lavfi", "-i",
                        f"anoisesrc=c={couleur}:a=0.9:d={total}:r=48000:seed={graine}"])
        n += 1
        return n - 1

    # L'air de la pièce : du grave, sous le seuil de l'attention.
    # Une seule source dupliquée sur les deux canaux : dans une vraie pièce le
    # grave est corrélé. Deux sources indépendantes sonnent diffus au casque et
    # perdent 3 dB dès qu'un lecteur resomme en mono.
    src = ajouter_bruit("brown", rng.randrange(10**6))
    canal = "pan=stereo|c0=c0|c1=c0," if canaux == 2 else ""
    graphe.append(f"[{src}:a]{canal}lowpass=f=200,volume={0.35 * a.salle:.3f}[air]")
    couches.append("[air]")

    # La rumeur : du bruit filtré dans la bande de la parole, modulé par trois
    # trémolos de périodes incommensurables — ça évite le battement régulier
    # qui trahirait la synthèse — puis noyé dans la réverbération de la salle.
    src = [ajouter_bruit("pink", rng.randrange(10**6)) for _ in range(canaux)]
    if canaux == 2:
        graphe.append(f"[{src[0]}:a][{src[1]}:a]amerge=inputs=2[rum_b]")
    else:
        graphe.append(f"[{src[0]}:a]anull[rum_b]")
    graphe.append(
        "[rum_b]highpass=f=260,lowpass=f=1700,"
        "tremolo=f=0.7:d=0.5,tremolo=f=1.3:d=0.35,tremolo=f=2.9:d=0.25,"
        "aecho=0.9:0.85:37|53|79:0.28|0.2|0.14,"
        f"volume={0.42 * a.rumeur / 55:.3f}[rumeur]")
    couches.append("[rumeur]")

    # Les événements, placés au hasard mais reproductibles. Le décalage entre
    # les deux oreilles les situe dans la salle sans toucher au volume.
    combien = max(1, int(a.densite * a.duree / 60))
    tirages = []
    for _ in range(combien):
        tirages.append((rng.randrange(len(evenements)),
                        rng.uniform(0.3, a.duree - 0.6),
                        rng.uniform(0.35, 1.0),
                        rng.uniform(-0.012, 0.012)))
    par_source = {}
    for idx, *reste in tirages:
        par_source.setdefault(idx, []).append(reste)

    for idx, places in par_source.items():
        entrees.extend(["-i", str(evenements[idx])])
        i = n
        n += 1
        sorties = [f"[ev{idx}_{k}]" for k in range(len(places))]
        graphe.append(f"[{i}:a]asplit={len(places)}" + "".join(sorties))
        for k, (instant, gain, pan) in enumerate(places):
            g = f"[ev{idx}_{k}]volume={gain:.3f}"
            if canaux == 2:
                gauche = int(instant * 1000 + max(0.0, pan) * 1000)
                droite = int(instant * 1000 + max(0.0, -pan) * 1000)
                g += f",aformat=channel_layouts=stereo,adelay={gauche}|{droite}"
            else:
                g += f",adelay={int(instant * 1000)}"
            g += f",apad=whole_dur={total}[pose{idx}_{k}]"
            graphe.append(g)
            couches.append(f"[pose{idx}_{k}]")

    graphe.append("".join(couches) +
                  f"amix=inputs={len(couches)}:normalize=0:duration=longest,"
                  f"lowpass=f=9000,atrim=0:{total},alimiter=limit=0.9[melange]")

    brut = tmp / "brut.wav"
    if os.environ.get("AMBIANCE_DEBUG"):
        print("\n".join(graphe), file=sys.stderr)
    ff(*entrees, "-filter_complex", ";".join(graphe), "-map", "[melange]",
       "-ar", "48000", "-ac", str(canaux), "-c:a", "pcm_f32le", str(brut))
    return brut


def raccorder(source: Path, cible: Path, L: float, X: float, canaux: int):
    """Referme la boucle : le début est fondu avec la queue qui le dépasse, donc
    la fin enchaîne exactement sur le début. Fondu en quart de sinus, à énergie
    constante — un fondu linéaire creuserait le niveau sur du bruit décorrélé."""
    graphe = (
        "[0:a]asplit=3[p1][p2][p3];"
        f"[p1]atrim=0:{X},afade=t=in:st=0:d={X}:curve=qsin[tete];"
        f"[p2]atrim={L}:{L + X},asetpts=PTS-STARTPTS,"
        f"afade=t=out:st=0:d={X}:curve=qsin[queue];"
        "[tete][queue]amix=inputs=2:normalize=0[raccord];"
        f"[p3]atrim={X}:{L},asetpts=PTS-STARTPTS[corps];"
        "[raccord][corps]concat=n=2:v=0:a=1[o]")
    ff("-i", str(source), "-filter_complex", graphe, "-map", "[o]",
       "-ar", "48000", "-ac", str(canaux), "-c:a", "pcm_f32le", str(cible))


def main():
    p = argparse.ArgumentParser(add_help=False)
    p.add_argument("-o", "--sortie", default=None)
    p.add_argument("-d", "--duree", default="60")
    p.add_argument("--fondu", type=float, default=3.0)
    p.add_argument("--densite", type=float, default=14.0,
                   help="événements par minute (verres, chaises)")
    p.add_argument("--rumeur", type=float, default=55.0, help="0 à 100")
    p.add_argument("--salle", type=float, default=1.0, help="poids de l'air de la pièce")
    p.add_argument("--niveau", type=float, default=-24.0, help="LUFS du fichier produit")
    p.add_argument("--mono", action="store_true")
    p.add_argument("--graine", type=int, default=1848)
    p.add_argument("-h", "--help", action="help")
    a = p.parse_args()
    a.duree = secondes(a.duree)
    if a.duree < a.fondu * 2:
        sys.exit(f"erreur : une boucle de {a.duree:g} s est trop courte pour un "
                 f"raccord de {a.fondu:g} s.")

    sortie = Path(a.sortie) if a.sortie else RACINE / "assets" / "ambiance-bar.wav"
    sortie.parent.mkdir(parents=True, exist_ok=True)
    canaux = 1 if a.mono else 2

    with tempfile.TemporaryDirectory(prefix="ambiance-") as d:
        tmp = Path(d)
        print(f"── couches ({'mono' if a.mono else 'stéréo'}, graine {a.graine})")
        brut = construire(a, tmp)
        print(f"── raccord de la boucle ({a.fondu:g} s, à énergie constante)")
        joint = tmp / "joint.wav"
        raccorder(brut, joint, a.duree, a.fondu, canaux)
        print(f"── mise à niveau ({a.niveau:g} LUFS)")
        ff("-i", str(joint), "-af",
           f"loudnorm=I={a.niveau}:TP=-3:LRA=20:linear=false",
           "-ar", "48000", "-ac", str(canaux), "-c:a", "pcm_s24le", str(sortie))

    print(f"\n✓ {sortie}")
    print(f"  {duree_de(sortie):.2f} s en boucle, à répéter autant que nécessaire")
    print(f"  bin/master --ambiance {sortie.relative_to(RACINE) if sortie.is_relative_to(RACINE) else sortie} …")


if __name__ == "__main__":
    main()
